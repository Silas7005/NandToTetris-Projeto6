class Maze {
    constructor Maze new() {
        return this;
    }

    method void dispose() {
        do Memory.deAlloc(this);
        return;
    }

    method void draw() {
        var int col, row;
        do Screen.clearScreen();
        let row = 2;
        while (row < 16) {
            let col = 0;
            while (col < 32) {
                do drawCell(col, row);
                let col = col + 1;
            }
            let row = row + 1;
        }
        return;
    }
    
    method boolean isWall(int col, int row) {
        if ((col < 0) | (col > 31) | (row < 2) | (row > 15)) {
            return true;
        }
        if ((col = 0) | (col = 31) | (row = 2) | (row = 15)) {
            return true;
        }

        if ((row = 4) & (col > 1) & (col < 9) & ~(col = 5)) { return true; }
        if ((row = 4) & (col > 11) & (col < 19) & ~(col = 15)) { return true; }
        if ((row = 4) & (col > 21) & (col < 30) & ~(col = 25)) { return true; }

        if ((row = 7) & (col > 1) & (col < 11) & ~(col = 7)) { return true; }
        if ((row = 7) & (col > 11) & (col < 21) & ~(col = 16)) { return true; }
        if ((row = 7) & (col > 21) & (col < 30) & ~(col = 26)) { return true; }

        if ((row = 10) & (col > 1) & (col < 9) & ~(col = 5)) { return true; }
        if ((row = 10) & (col > 10) & (col < 20) & ~(col = 15)) { return true; }
        if ((row = 10) & (col > 21) & (col < 30) & ~(col = 25)) { return true; }

        if ((row = 13) & (col > 2) & (col < 11) & ~(col = 6)) { return true; }
        if ((row = 13) & (col > 12) & (col < 21) & ~(col = 16)) { return true; }
        if ((row = 13) & (col > 22) & (col < 30) & ~(col = 26)) { return true; }

        if ((col = 10) & (row > 2) & (row < 7) & ~(row = 5)) { return true; }
        if ((col = 20) & (row > 2) & (row < 7) & ~(row = 4)) { return true; }
        if ((col = 10) & (row > 7) & (row < 10)) { return true; }
        if ((col = 20) & (row > 7) & (row < 10)) { return true; }
        if ((col = 10) & (row > 10) & (row < 15) & ~(row = 12)) { return true; }
        if ((col = 20) & (row > 10) & (row < 15) & ~(row = 13)) { return true; }

        return false;
    }

    method void drawCell(int col, int row) {
        var int x, y;
        let x = col * 16;
        let y = row * 16;
        if (isWall(col, row)) {
            do Screen.setColor(true);
        } else {
            do Screen.setColor(false);
        }
        do Screen.drawRectangle(x, y, x + 15, y + 15);
        do Screen.setColor(true);
        return;
    }
}

