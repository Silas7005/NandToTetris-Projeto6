class Random {
    field int seed;

    constructor Random new(int seedIn) {
        let seed = seedIn;
        return this;
    }

    method int rand() {
        let seed = seed + 20251;
        if (seed < 0) {
            let seed = seed + 20251;
        }
        return seed;
    }

    method int randRange(int range) {
        var int mask;
        var int result;
        let mask = 1;
        while (mask < range) {
            let mask = (mask * 2) + 1;
        }
        let result = rand() & mask;
        while (result > range) {
            let result = rand() & mask;
        }
        return result;
    }

    method void dispose() {
        do Memory.deAlloc(this);
        return;
    }
}
