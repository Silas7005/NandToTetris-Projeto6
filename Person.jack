class Person{
    field int lin, col;

    constructor Person new(int initLin, int initCol){
        let lin = initLin;
        let col = initCol;
        return this
    }

    method void setPosition(int newLin, int newCol){
        let lin = newLin;
        let col = newCol;
        do draw();
        return;
    }

    method void moveTo(int newLin, int newCol){
        let lin = newLin;
        let col = newCol;
        do draw();
        return;
    }

    method int getLin() {
      return lin;
   }
    method int getCol() {
      return col;
   }

    method void draw() {
      var int x, y;
      let x = col * 16;
      let y = (lin + 2) * 16;
      do Screen.setColor(true);
      do Screen.drawCircle(x + 8, y + 4, 3);
      do Screen.drawRectangle(x + 6, y + 7, x + 9, y + 11);
      do Screen.drawRectangle(x + 2, y + 8, x + 13, y + 9);
      do Screen.drawRectangle(x + 4, y + 12, x + 6, y + 15);
      do Screen.drawRectangle(x + 9, y + 12, x + 11, y + 15);
      return;
   }

    method void erase() {
      var int x, y;
      let x = col * 16;
      let y = (lin + 2) * 16;
      do Screen.setColor(false);
      do Screen.drawRectangle(x, y, x + 15, y + 15);
      return;
    }

    method void dispose() {
      do Memory.deAlloc(this);
      return;
    }
}